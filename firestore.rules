rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function sess() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        && exists(/databases/$(database)/documents/access/$(sess().code));
    }

    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /access/{code} {
      allow get: if true;
      allow list, write: if isTeacher();
    }

    match /sessions/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow delete: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'class', 'code', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data['class'] in ['9', '10', '11', '12']
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/access/$(request.resource.data.code))
        && request.resource.data.at == request.time;
    }

    match /chapters/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data['class'] == sess()['class']);
      allow write: if isTeacher();
    }
  }
}
