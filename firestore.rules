rules_version = '2';
// UHS धामू चक — सुरक्षा नियम
// इन्हें Firebase Console → Firestore Database → Rules में पूरा paste करके "Publish" दबाएँ।
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    // बच्चा तभी पढ़ सकता है जब: लिस्ट में हो, चालू हो, और उसी मोबाइल-login से हो जिससे पहली बार जुड़ा था
    function isActiveStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && me().active == true
        && me().boundAuthTime == request.auth.token.auth_time;
    }

    // टीचर लिस्ट: सिर्फ Firebase Console से बदली जा सकती है
    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // रोल नंबर → अंदरूनी login ईमेल (PIN यहाँ नहीं रहता)
    match /logins/{key} {
      allow get: if true;
      allow list: if isTeacher();
      allow write: if isTeacher();
    }

    match /students/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
        // बच्चा सिर्फ एक बार अपना मोबाइल जोड़ सकता है (जब टीचर ने Reset किया हो / पहली बार)
        || (signedIn() && request.auth.uid == uid
            && resource.data.active == true
            && resource.data.boundAuthTime == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boundAuthTime', 'boundAt'])
            && request.resource.data.boundAuthTime == request.auth.token.auth_time
            && request.resource.data.boundAt == request.time);
    }

    // चैप्टर और वीडियो: टीचर सब देख सकते हैं, बच्चा सिर्फ अपनी कक्षा के
    match /chapters/{id} {
      allow read: if isTeacher() || (isActiveStudent() && resource.data['class'] == me()['class']);
      allow write: if isTeacher();
    }
  }
}
